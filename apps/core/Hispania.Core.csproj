<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hispania.Core</AssemblyName>
    <RootNamespace>Hispania.Core</RootNamespace>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <CoreModuleHostRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</CoreModuleHostRuntimeIdentifier>
    <CoreModuleHostRuntimeIdentifier Condition="'$(CoreModuleHostRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</CoreModuleHostRuntimeIdentifier>
    <CoreModuleHostRuntimeIdentifier Condition="'$(CoreModuleHostRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</CoreModuleHostRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Hispania.Core.Tests" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <ProjectReference Include="..\..\core\runtime\Hispania.Runtime.csproj" />
    <ProjectReference Include="..\module-host\Hispania.ModuleHost.csproj" ReferenceOutputAssembly="false" Private="false" AdditionalProperties="RuntimeIdentifier=$(CoreModuleHostRuntimeIdentifier)" />
    <ProjectReference Include="..\..\contracts\module-system\Hispania.ModuleSystem.Contracts.csproj" />
    <ProjectReference Include="..\..\contracts\platform\Hispania.Platform.Contracts.csproj" />
  </ItemGroup>
  <Target Name="CopyModuleHostForCoreBuild" AfterTargets="Build">
    <ItemGroup>
      <ModuleHostFiles Include="..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleHost.dll;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleHost.deps.json;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleHost.runtimeconfig.json;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleSystem.Contracts.dll;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.Platform.Contracts.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)module-host" />
    <Copy SourceFiles="@(ModuleHostFiles)" DestinationFolder="$(OutputPath)module-host" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyModuleHostForCorePublish" AfterTargets="Publish">
    <ItemGroup>
      <ModuleHostPublishFiles Include="..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleHost.dll;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleHost.deps.json;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleHost.runtimeconfig.json;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.ModuleSystem.Contracts.dll;..\module-host\bin\$(Configuration)\$(TargetFramework)\$(CoreModuleHostRuntimeIdentifier)\Hispania.Platform.Contracts.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)module-host" />
    <Copy SourceFiles="@(ModuleHostPublishFiles)" DestinationFolder="$(PublishDir)module-host" SkipUnchangedFiles="true" />
  </Target>
</Project>
