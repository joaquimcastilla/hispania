{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hispania.invalid/schemas/core-artifact-manifest-v1.schema.json",
  "title": "HISPANIA Core Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "sourceCommit", "targetFramework", "runtimeIdentifier", "publishMode", "generatedAtUtc", "contentId", "files", "dependencies", "exceptions", "policyResult"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "sourceCommit": { "type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$" },
    "targetFramework": { "type": "string", "minLength": 1 },
    "runtimeIdentifier": { "enum": ["win-x64", "linux-x64", "linux-arm64"] },
    "publishMode": { "enum": ["framework-dependent", "self-contained"] },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "contentId": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "exceptions": { "type": "array", "description": "Must be empty under allowlist v1; non-empty exceptions are rejected fail-closed until separately approved and implemented.", "items": { "$ref": "#/$defs/exception" } },
    "policyResult": {
      "type": "object", "additionalProperties": false,
      "required": ["policyId", "status", "issues"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256", "fileType"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "fileType": { "enum": ["applicationHost", "managedAssembly", "nativeRuntime", "dependencyManifest", "runtimeConfig", "content"] },
        "origin": { "type": ["string", "null"] }
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version", "phase", "direct"],
      "properties": {
        "kind": { "enum": ["project", "package", "framework", "runtimeAsset"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["build", "runtime", "publish"] },
        "direct": { "type": "boolean" }
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "justification", "scope", "evidence", "approval", "reviewByUtc"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "approval": { "type": "string", "minLength": 1 },
        "reviewByUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
